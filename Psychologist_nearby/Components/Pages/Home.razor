@page "/"

<PageTitle>Home</PageTitle>

<div class="home-container">

    <div class="hero-section">
        <div class="hero-content">
            <h1 class="hero-title">Наталья Паэглис</h1>
            <p class="hero-subtitle">Психолог</p>
            <p>
                <a href="#contacts" class="btn-primary">
                    запись на бесплатную диагностическую сессию
                </a>
            </p>
        </div>
        <div class="hero-image-wrapper">
            <img src="images/first.jpg" alt="Наталья Паэглис" class="hero-image">
        </div>
    </div>

    <div id="about" class="section-scroll">
        <div class="avatar-wrapper">
            <img src="images/third.jpg" class="avatar-image">
        </div>

        <div class="section-container">
            <h1 class="section-title">Обо мне</h1>
            <div class="content-box">
                <h1 class="box-text">текст</h1>
            </div>
        </div>
    </div>

    <div id="requests" class="section-container requests-section">
        <h1 class="section-title">Запросы с которыми я работаю</h1>
        <div class="requests-grid">
            <div class="request-card">отношения</div>
            <div class="request-card">депрессия</div>
            <div class="request-card">тревога</div>
            <div class="request-card">стресс</div>
            <div class="request-card">трудности в общении</div>
            <div class="request-card">недостаток мотивации</div>
        </div>
    </div>

    <div id="reviews" class="section-container default-section">
        <h1 class="section-title">Отзывы</h1>
        <div class="content-box">
            <h1 class="box-text">текст</h1>
        </div>
    </div>

    <div id="price" class="section-container default-section">
        <h1 class="section-title">Стоимость</h1>
        <div class="content-box">
            <h1 class="box-text">текст</h1>
        </div>
    </div>

    <div id="testing" class="section-container default-section">
        <h1 class="section-title">Тестирование</h1>
        <div class="content-box">
            <h1 class="box-text">текст</h1>
        </div>
    </div>

    <div id="contacts" class="section-container default-section">
        <h1 class="section-title">Контакты</h1>
        <div class="content-box">
            <h1 class="box-text">текст</h1>
        </div>
    </div>

</div>