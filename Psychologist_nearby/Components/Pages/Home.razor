@page "/"

<PageTitle>Home</PageTitle>

<div style="background-color: #6d7466; min-height: 100vh; width: 100vw; margin-left: calc(-50vw + 50%); padding: 0; box-sizing: border-box; scroll-behavior: smooth;">

    <div style="display: flex; justify-content: flex-start; align-items: center; min-height: 100vh; padding-left: 5%; background-color: #6E7363;">
        <div style="text-align: left; max-width: 600px; padding-right: 60px; z-index: 2;">
            <h1 style="font-size: 4.35rem; font-weight: 700; margin-bottom: 10px; color: #FFFFFF;">Наталья Паэглис</h1>
            <p style="color: #FFE5CA; margin-bottom: 20px; font-size: 2.35rem; font-weight: 700;">Психолог</p>
            <p>
                <a href="#contacts" style="display: flex; justify-content: center; align-items: center; text-align: center; text-decoration: none; padding: 10px 20px; cursor: pointer; background: #665A4C; border-radius: 20px; color: #FFFFFF; font-size: 1.6rem; font-weight: 700; border: none;">
                    запись на бесплатную диагностическую сессию
                </a>
            </p>
        </div>
        <div style="flex: 1; display: flex; height: 100vh;">
            <img src="images/first.jpg" alt="Наталья Паэглис" style="width: 100%; height: 100vh; object-fit: cover; object-position: 85% center; -webkit-mask-image: linear-gradient(to right, transparent 0%, black 50%); mask-image: linear-gradient(to right, transparent 0%, black 50%);">
        </div>
    </div>

    <div id="about" style="scroll-margin-top: 80px;">
        <div style="flex: 1; display: flex; justify-content: center; align-items: center; padding: 20px 0;">
            <img src="images/third.jpg" style="width: 180px; height: 180px; object-fit: cover; border-radius: 50%;">
        </div>

        <div style="display: flex; flex-direction: column; align-items: center; min-height: 100vh; padding-top: 10px;">
            <h1 style="font-size: 2.5rem; margin-bottom: 20px;color: #FFFFFF; font-weight: 700;">Обо мне</h1>
            <div style="display: flex; justify-content: center; align-items: center; background-color: #C6BBAA; min-height: 20vh; width: 80%; max-width: 800px; border-radius: 12px;">
                <h1 style="font-size: 2.5rem; margin: 0;font-weight: 600;">текст</h1>
            </div>
        </div>
    </div>

    <div id="requests" style="display: flex; flex-direction: column; align-items: center; min-height: 100vh; padding-top: 50px; scroll-margin-top: 80px;">
        <h1 style="font-size: 2.5rem; margin-bottom: 30px;color: #FFFFFF; font-weight: 700;">Запросы с которыми я работаю</h1>
        <div style="display: grid; grid-template-columns: repeat(3, 1fr); gap: 20px; background-color: #C6BBAA; width: 80%; max-width: 900px; padding: 30px; border-radius: 12px; text-align: center;">
            <div style="font-size: 1.5rem;font-weight: 600; background-color: rgba(255,255,255,0.4); padding: 20px; border-radius: 8px;">отношения</div>
            <div style="font-size: 1.5rem;font-weight: 600; background-color: rgba(255,255,255,0.4); padding: 20px; border-radius: 8px;">депрессия</div>
            <div style="font-size: 1.5rem;font-weight: 600; background-color: rgba(255,255,255,0.4); padding: 20px; border-radius: 8px;">тревога</div>
            <div style="font-size: 1.5rem;font-weight: 600; background-color: rgba(255,255,255,0.4); padding: 20px; border-radius: 8px;">стресс</div>
            <div style="font-size: 1.5rem;font-weight: 600; background-color: rgba(255,255,255,0.4); padding: 20px; border-radius: 8px;">трудности в общении</div>
            <div style="font-size: 1.5rem;font-weight: 600; background-color: rgba(255,255,255,0.4); padding: 20px; border-radius: 8px;">недостаток мотивации</div>
        </div>
    </div>

    <div id="reviews" style="display: flex; flex-direction: column; align-items: center; min-height: 100vh; padding-top: 50px; scroll-margin-top: 80px;">
        <h1 style="font-size: 2.5rem; margin-bottom: 30px;color: #FFFFFF; font-weight: 700;">Отзывы</h1>
        <div style="display: flex; justify-content: center; align-items: center; background-color: #C6BBAA; min-height: 20vh; width: 80%; max-width: 800px; border-radius: 12px;">
            <h1 style="font-size: 2.5rem; margin: 0;font-weight: 600;">текст</h1>
        </div>
    </div>

    <div id="price" style="display: flex; flex-direction: column; align-items: center; min-height: 100vh; padding-top: 50px; scroll-margin-top: 80px;">
        <h1 style="font-size: 2.5rem; margin-bottom: 30px;color: #FFFFFF; font-weight: 700;">Стоимость</h1>
        <div style="display: flex; justify-content: center; align-items: center; background-color: #C6BBAA; min-height: 20vh; width: 80%; max-width: 800px; border-radius: 12px;">
            <h1 style="font-size: 2.5rem; margin: 0;font-weight: 600;">текст</h1>
        </div>
    </div>

    <div id="testing" style="display: flex; flex-direction: column; align-items: center; min-height: 100vh; padding-top: 50px; scroll-margin-top: 80px;">
        <h1 style="font-size: 2.5rem; margin-bottom: 30px;color: #FFFFFF; font-weight: 700;">Тестирование</h1>
        <div style="display: flex; justify-content: center; align-items: center; background-color: #C6BBAA; min-height: 20vh; width: 80%; max-width: 800px; border-radius: 12px;">
            <h1 style="font-size: 2.5rem; margin: 0;font-weight: 600;">текст</h1>
        </div>
    </div>

    <div id="contacts" style="display: flex; flex-direction: column; align-items: center; min-height: 100vh; padding-top: 50px; scroll-margin-top: 80px;">
        <h1 style="font-size: 2.5rem; margin-bottom: 30px;color: #FFFFFF; font-weight: 700;">Контакты</h1>
        <div style="display: flex; justify-content: center; align-items: center; background-color: #C6BBAA; min-height: 20vh; width: 80%; max-width: 800px; border-radius: 12px;">
            <h1 style="font-size: 2.5rem; margin: 0;font-weight: 600;">текст</h1>
        </div>
    </div>

</div>