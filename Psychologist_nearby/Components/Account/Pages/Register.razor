@page "/Account/Register"

@using System.ComponentModel.DataAnnotations
@using Microsoft.EntityFrameworkCore
@using Psychologist_nearby.Data

@inject ApplicationDbContext DbContext
@inject ILogger<Register> Logger
@inject NavigationManager NavigationManager

<PageTitle>Регистрация</PageTitle>

<div class="register-page-container">
    <div class="register-card">
        <h1 class="register-title">Регистрация</h1>

        @if (!string.IsNullOrEmpty(errorMessage))
        {
            <div class="alert alert-danger">@errorMessage</div>
        }

        <EditForm Model="Input" OnValidSubmit="RegisterUser" FormName="register">
            <DataAnnotationsValidator />

            <div class="form-group">
                <label for="email" class="form-label">Email</label>
                <InputText @bind-Value="Input.Email" class="form-control" autocomplete="username" aria-required="true" placeholder="name@example.com" />
                <ValidationMessage For="() => Input.Email" />
            </div>

            <div class="form-group">
                <label for="password" class="form-label">Пароль</label>
                <InputText type="password" @bind-Value="Input.Password" class="form-control" autocomplete="new-password" aria-required="true" placeholder="••••••••" />
                <ValidationMessage For="() => Input.Password" />
            </div>

            <div class="form-group">
                <label for="confirm-password" class="form-label">Подтвердите пароль</label>
                <InputText type="password" @bind-Value="Input.ConfirmPassword" class="form-control" autocomplete="new-password" aria-required="true" placeholder="••••••••" />
                <ValidationMessage For="() => Input.ConfirmPassword" />
            </div>

            <button type="submit" class="btn-submit">
                Зарегистрироваться
            </button>

            <div class="login-link-container">
                <a href="@(NavigationManager.GetUriWithQueryParameters("Account/Login", new Dictionary<string, object?> { ["ReturnUrl"] = ReturnUrl }))" class="login-link">
                    Уже есть аккаунт? Войти
                </a>
            </div>
        </EditForm>
    </div>
</div>

@code {
    private string? errorMessage;

    [SupplyParameterFromForm]
    private InputModel Input { get; set; } = new();

    [SupplyParameterFromQuery]
    private string? ReturnUrl { get; set; }

    public async Task RegisterUser()
    {

        string? loginUrl = null;

        try
        {
            string email = Input.Email.Trim().ToLowerInvariant();

            if (string.IsNullOrWhiteSpace(email) ||
            !new EmailAddressAttribute().IsValid(email))
            {
                errorMessage = "Введите корректный адрес электронной почты.";
                return;
            }

            if (email.Length > 100)
            {
                errorMessage = "Почта не должна содержать больше 100 символов.";
                return;
            }

            if (Input.Password.Length < 8 || Input.Password.Length > 40)
            {
                errorMessage = "Пароль должен содержать от 8 до 40 символов.";
                return;
            }

            if (!Input.Password.Any(char.IsUpper))
            {
                errorMessage = "Пароль должен содержать хотя бы одну заглавную букву.";
                return;
            }

            if (!Input.Password.Any(char.IsLower))
            {
                errorMessage = "Пароль должен содержать хотя бы одну строчную букву.";
                return;
            }

            if (!Input.Password.Any(char.IsDigit))
            {
                errorMessage = "Пароль должен содержать хотя бы одну цифру.";
                return;
            }

            if (!Input.Password.Any(c =>
                    !char.IsLetterOrDigit(c) && !char.IsWhiteSpace(c)))
            {
                errorMessage = "Пароль должен содержать хотя бы один специальный символ.";
                return;
            }

            if (Input.Password.Any(char.IsWhiteSpace))
            {
                errorMessage = "Пароль не должен содержать пробелы.";
                return;
            }

            if (Input.Password != Input.ConfirmPassword)
            {
                errorMessage = "Пароли не совпадают.";
                return;
            }

            // 1. Проверяем, существует ли уже пользователь с таким Email
            var existingUser = await DbContext.Users.AnyAsync(u => u.Email == Input.Email);
            if (existingUser)
            {
                errorMessage = "Пользователь с таким e-mail уже зарегистрирован.";
                return;
            }

            // 2. Получаем ID роли по умолчанию ("Client")
            var clientRole = await DbContext.Roles.FirstOrDefaultAsync(r => r.Name == "Client");
            int roleId = clientRole?.Id ?? 1;

            // 3. Хэшируем пароль через BCrypt
            string hashedPassword = BCrypt.Net.BCrypt.HashPassword(Input.Password);

            // 4. Генерируем 6-значный код подтверждения
            string confirmationCode = new Random().Next(100000, 999999).ToString();

            var newUser = new User
            {
                Email = Input.Email,
                PasswordHash = hashedPassword,
                RoleId = roleId,
                IsEmailConfirmed = false,
                EmailConfirmationCode = confirmationCode,
                CodeExpiryTime = DateTime.Now.AddMinutes(10),
                TimeCreated = DateTime.Now
            };

            DbContext.Users.Add(newUser);
            await DbContext.SaveChangesAsync();

            Logger.LogInformation("Создан новый пользователь в БД: {Email}", newUser.Email);

            loginUrl = NavigationManager.GetUriWithQueryParameters("Account/Login", new Dictionary<string, object?>
            {
                ["ReturnUrl"] = ReturnUrl
            });

        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Ошибка при регистрации пользователя {Email}", Input.Email);
            errorMessage = "Произошла ошибка при сохранении данных. Попробуйте снова.";
            return;
        }

        if (!string.IsNullOrEmpty(loginUrl))
        {
            NavigationManager.NavigateTo(loginUrl, forceLoad: true);
        }
    }

    private sealed class InputModel
    {
        [Required(ErrorMessage = "Введите e-mail")]
        [Display(Name = "Email")]
        public string Email { get; set; } = "";

        [Required(ErrorMessage = "Введите пароль")]
        [DataType(DataType.Password)]
        [Display(Name = "Пароль")]
        public string Password { get; set; } = "";

        [Required(ErrorMessage = "Подтвердите пароль")]
        [DataType(DataType.Password)]
        [Display(Name = "Подтверждение пароля")]
        public string ConfirmPassword { get; set; } = "";
    }
}