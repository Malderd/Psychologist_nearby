@page "/Account/PersonalAccount"

@using System.Security.Claims
@using System.ComponentModel.DataAnnotations
@using Microsoft.EntityFrameworkCore
@using Microsoft.AspNetCore.Components.Authorization
@using Psychologist_nearby.Data
@using Psychologist_nearby.Services

@inject IDbContextFactory<ApplicationDbContext> DbFactory
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject ILogger<PersonalAccount> Logger
@inject Psychologist_nearby.Data.IAuthValidator AuthValidator
@inject AppointmentService AppointmentService

<PageTitle>Личный кабинет</PageTitle>

<div class="account-page-container">
    <div class="account-dashboard-layout">

        <!-- ЛЕВОЕ МЕНЮ НАВИГАЦИИ ЛИЧНОГО КАБИНЕТА -->
        <div class="account-sidebar">
            <h3 class="sidebar-title">Кабинет</h3>
            <ul class="sidebar-menu">
                <li>
                    <button type="button" class="@(activeTab == "profile" ? "sidebar-link active" : "sidebar-link")"
                            @onclick='() => ChangeTab("profile")'>
                        Профиль
                    </button>
                </li>
                <li>
                    <button type="button" class="@(activeTab == "statistics" ? "sidebar-link active" : "sidebar-link")"
                            @onclick='() => ChangeTab("statistics")'>
                        Статистика тестов
                    </button>
                </li>
                <li>
                    <button type="button" class="@(activeTab == "schedule" ? "sidebar-link active" : "sidebar-link")"
                            @onclick='() => ChangeTab("schedule")'>
                        Расписание / Запись
                    </button>
                </li>
            </ul>

            <div class="sidebar-footer mt-auto pt-4">
                <form action="/Account/Logout" method="post" @formname="logout-sidebar" class="logout-form">
                    <AntiforgeryToken />
                    <button type="submit" class="btn-logout w-100">Выйти</button>
                </form>
            </div>
        </div>

            <div class="sidebar-footer mt-auto pt-4">
                <form action="/Account/Logout" method="post" @formname="logout-sidebar" class="logout-form">
                    <AntiforgeryToken />
                    <button type="submit" class="btn-logout w-100">Выйти</button>
                </form>
            </div>
        </div>

        <!-- ПРАВАЯ ЧАСТЬ: КОНТЕНТ ВКЛАДОК -->
        <div class="account-content">
            @if (isLoading)
            {
                <div class="account-card">
                    <p>Загрузка данных...</p>
                </div>
            }
            else if (!isUserLoaded)
            {
                <div class="account-card">
                    <div class="alert alert-danger">@errorMessage</div>
                </div>
            }
            else
            {
                <!-- ВКЛАДКА 1: ПРОФИЛЬ -->
                @if (activeTab == "profile")
                {
                    <div class="account-card">
                        <h1 class="account-title">Личные данные</h1>

                        @if (!string.IsNullOrEmpty(errorMessage))
                        {
                            <div class="alert alert-danger">@errorMessage</div>
                        }

                        @if (!string.IsNullOrEmpty(successMessage))
                        {
                            <div class="alert alert-success">@successMessage</div>
                        }

                        <EditForm Model="Input" OnValidSubmit="@SaveChanges" FormName="personalAccount">
                            <DataAnnotationsValidator />
                            <ValidationSummary />

                            <div class="form-group">
                                <label for="email" class="form-label">Почта</label>
                                <input id="email" type="email" class="form-control" value="@Input?.Email" readonly />
                            </div>

                            <div class="form-group">
                                <label for="name" class="form-label">Имя</label>
                                <InputText id="name" class="form-control" @bind-Value="Input!.Name" placeholder="Отсутствует" maxlength="150" />
                                <ValidationMessage For="@(() => Input.Name)" />
                            </div>

                            <div class="form-group">
                                <label for="surname" class="form-label">Фамилия</label>
                                <InputText id="surname" class="form-control" @bind-Value="Input.Surname" placeholder="Отсутствует" maxlength="150" />
                                <ValidationMessage For="@(() => Input.Surname)" />
                            </div>

                            <div class="form-group">
                                <label for="phone" class="form-label">Телефон</label>
                                <InputText id="phone" class="form-control" @bind-Value="Input.Phone" placeholder="Отсутствует" inputmode="numeric" maxlength="10" />
                                <ValidationMessage For="@(() => Input.Phone)" />
                            </div>

                            <button type="submit" class="btn-save" disabled="@isSaving">
                                @(isSaving ? "Сохранение..." : "Сохранить")
                            </button>
                        </EditForm>
                    </div>
                }

                <!-- ВКЛАДКА 2: СТАТИСТИКА -->
                @if (activeTab == "statistics")
                {
                    <div class="statistics-card">
                        <h2 class="statistics-title">Статистика тестирования</h2>

                        @if (testResults.Count == 0)
                        {
                            <div class="statistics-empty">
                                <p>Вы пока не проходили тестирование.</p>
                            </div>
                        }
                        else
                        {
                            <div class="statistics-list">
                                @foreach (var result in testResults)
                                {
                                    <div class="statistics-item">
                                        <h3 class="statistics-test-title">@(result.Test?.Title ?? "Тест не найден")</h3>
                                        <p><strong>Дата прохождения:</strong> @result.TimeCreated.ToString("dd.MM.yyyy HH:mm")</p>
                                        <p><strong>Набрано баллов:</strong> @result.TotalScore из @GetMaxScore(result)</p>
                                        <p><strong>Результат:</strong> @(string.IsNullOrWhiteSpace(result.Interpretation) ? "Не указан" : result.Interpretation)</p>
                                    </div>
                                }
                            </div>
                        }
                    </div>
                }

                <!-- ВКЛАДКА 3: РАСПИСАНИЕ И ЗАПИСЬ -->
                @if (activeTab == "schedule")
                {
                    <div class="account-card">
                        <h2 class="account-title">Расписание и запись на прием</h2>

                        @if (!string.IsNullOrEmpty(bookingMessage))
                        {
                            <div class="alert @(isBookingSuccess ? "alert-success" : "alert-danger")">
                                @bookingMessage
                            </div>
                        }

                        <p class="text-muted">Правила записи: с 10:00 до 20:00, строго на ровный час, не более 4 записей в день.</p>

                        <div class="form-group mb-3">
                            <label class="form-label">Выберите дату и время сеанса:</label>
                            <input type="datetime-local" @bind="selectedAppointmentDate" class="form-control" />
                        </div>

                        <div class="form-group mb-3">
                            <label class="form-label">ID Психолога:</label>
                            <input type="number" @bind="targetPsychologistId" class="form-control" placeholder="Введите ID психолога" />
                        </div>

                        <button class="btn-save" @onclick="BookAppointmentSlot">
                            Записаться
                        </button>
                    </div>
                }
            }
        </div>

    </div>

@code {
    private string activeTab = "profile";

    [SupplyParameterFromForm(FormName = "personalAccount")]
    private UserInput? Input { get; set; }
    private List<TestResult> testResults = new();

    private bool isLoading = true;
    private bool isSaving;
    private bool isUserLoaded;

    private string? errorMessage;
    private string? successMessage;
    private int currentUserId;

    private DateTime selectedAppointmentDate = DateTime.Now.Date.AddHours(10);
    private int targetPsychologistId = 1;
    private string? bookingMessage;
    private bool isBookingSuccess;

    protected override async Task OnInitializedAsync()
    {
        var submittedInput = Input;

        try
        {
            var authState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
            var principal = authState.User;

            if (principal.Identity?.IsAuthenticated != true ||
                !int.TryParse(principal.FindFirstValue(ClaimTypes.NameIdentifier), out currentUserId))
            {
                errorMessage = "Необходимо войти в аккаунт.";
                return;
            }

            await using var db = await DbFactory.CreateDbContextAsync();

            var user = await db.Users
                .AsNoTracking()
                .FirstOrDefaultAsync(u => u.Id == currentUserId);

            if (user is null)
            {
                errorMessage = "Пользователь не найден.";
                return;
            }

            testResults = await db.TestResults
                .AsNoTracking()
                .Include(r => r.Test)
                    .ThenInclude(t => t!.Answers)
                .Include(r => r.Test)
                    .ThenInclude(t => t!.Questions)
                .Where(r => r.UserId == currentUserId)
                .OrderByDescending(r => r.TimeCreated)
                .ToListAsync();

            if (submittedInput is null)
            {
                Input = new UserInput
                {
                    Email = user.Email ?? string.Empty,
                    Name = user.Name ?? string.Empty,
                    Surname = user.Surname ?? string.Empty,
                    Phone = user.Phone ?? string.Empty
                };
            }
            else
            {
                Input = submittedInput;
                Input.Email = user.Email ?? string.Empty;
            }

            isUserLoaded = true;
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Ошибка загрузки личного кабинета пользователя {UserId}", currentUserId);
            errorMessage = "Не удалось загрузить данные. Попробуйте позже.";
        }
        finally
        {
            isLoading = false;
        }
    }
    private void ChangeTab(string tabName)
    {
        activeTab = tabName;
        errorMessage = null;
        successMessage = null;
        bookingMessage = null;
        StateHasChanged();
    }

    private int GetMaxScore(TestResult result)
    {
        if (result.Test?.Questions == null || result.Test?.Answers == null ||
            result.Test.Questions.Count == 0 || result.Test.Answers.Count == 0)
        {
            return 0;
        }
        return result.Test.Questions.Count * result.Test.Answers.Max(a => a.Score);
    }

    private async Task SaveChanges()
    {
        if (isSaving || Input is null) return;

        if (!AuthValidator.IsNameValid(Input.Name) || !AuthValidator.IsSurnameValid(Input.Surname) || !AuthValidator.IsPhoneValid(Input.Phone))
        {
            errorMessage = "Проверьте правильность введенных данных (имя, фамилия, телефон).";
            return;
        }

        isSaving = true;
        errorMessage = null;
        successMessage = null;

        try
        {
            await using var db = await DbFactory.CreateDbContextAsync();
            var user = await db.Users.FirstOrDefaultAsync(u => u.Id == currentUserId);

            if (user is null)
            {
                errorMessage = "Пользователь не найден.";
                return;
            }

            user.Name = AuthValidator.EmptyToNull(Input.Name);
            user.Surname = AuthValidator.EmptyToNull(Input.Surname);
            user.Phone = AuthValidator.EmptyToNull(Input.Phone);

            await db.SaveChangesAsync();
            successMessage = "Данные успешно сохранены.";
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Ошибка сохранения личного кабинета пользователя {UserId}", currentUserId);
            errorMessage = "Не удалось сохранить данные.";
        }
        finally
        {
            isSaving = false;
        }
    }

    private async Task BookAppointmentSlot()
    {
        bookingMessage = null;
        isBookingSuccess = false;

        string? error = await AppointmentService.CreateAppointmentAsync(currentUserId, targetPsychologistId, selectedAppointmentDate);

        if (error != null)
        {
            bookingMessage = error;
            isBookingSuccess = false;
        }
        else
        {
            bookingMessage = "Запись успешно создана!";
            isBookingSuccess = true;
        }
    }

    private sealed class UserInput
    {
        public string Email { get; set; } = string.Empty;
        public string Name { get; set; } = string.Empty;
        public string Surname { get; set; } = string.Empty;
        public string Phone { get; set; } = string.Empty;
    }
}
