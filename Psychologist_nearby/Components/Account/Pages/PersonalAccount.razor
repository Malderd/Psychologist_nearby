@page "/Account/PersonalAccount"

@using System.Security.Claims
@using System.ComponentModel.DataAnnotations
@using System.Text.RegularExpressions
@using Microsoft.EntityFrameworkCore
@using Microsoft.AspNetCore.Components.Authorization
@using Psychologist_nearby.Data

@inject IDbContextFactory<ApplicationDbContext> DbFactory
@inject AuthenticationStateProvider AuthenticationStateProvider

<PageTitle>Личный кабинет</PageTitle>

<div class="account-page-container">
    <div class="account-card">
        <h1 class="account-title">Личный кабинет</h1>

        @if (isLoading)
        {
            <p>Загрузка данных...</p>
        }
        else if (!string.IsNullOrEmpty(errorMessage) && !isSaved)
        {
            <div class="alert alert-danger">@errorMessage</div>
        }
        else
        {
            @if (!string.IsNullOrEmpty(successMessage))
            {
                <div class="alert alert-success">@successMessage</div>
            }

            @if (!string.IsNullOrEmpty(errorMessage))
            {
                <div class="alert alert-danger">@errorMessage</div>
            }

            <EditForm Model="Input" OnValidSubmit="SaveChanges">
                <DataAnnotationsValidator />

                <div class="form-group">
                    <label for="email" class="form-label">Почта</label>
                    <input id="email"
                           type="email"
                           class="form-control"
                           value="@GetValue(Input.Email)"
                           readonly />
                </div>

                <div class="form-group">
                    <label for="name" class="form-label">Имя</label>
                    <InputText id="name"
                               class="form-control"
                               @bind-Value="Input.Name"
                               placeholder="Отсутствует" />
                    <ValidationMessage For="@(() => Input.Name)" />
                </div>

                <div class="form-group">
                    <label for="surname" class="form-label">Фамилия</label>
                    <InputText id="surname"
                               class="form-control"
                               @bind-Value="Input.Surname"
                               placeholder="Отсутствует" />
                    <ValidationMessage For="@(() => Input.Surname)" />
                </div>

                <div class="form-group">
                    <label for="phone" class="form-label">Телефон</label>
                    <InputText id="phone"
                               class="form-control"
                               @bind-Value="Input.Phone"
                               placeholder="Отсутствует"
                               inputmode="numeric"
                               maxlength="10" />
                    <ValidationMessage For="@(() => Input.Phone)" />
                </div>

                <button type="submit"
                        class="btn-save"
                        disabled="@isSaving">
                    @(isSaving ? "Сохранение..." : "Сохранить")
                </button>
            </EditForm>
        }

        <form action="/Account/Logout" method="post">
            <AntiforgeryToken />

            <button type="submit" class="btn-logout">
                Выйти
            </button>
        </form>
    </div>
</div>

@code {
    private UserInput Input { get; set; } = new();

    private bool isLoading = true;
    private bool isSaving;
    private bool isSaved;
    private string? errorMessage;
    private string? successMessage;

    private int currentUserId;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            var authState =
                await AuthenticationStateProvider
                    .GetAuthenticationStateAsync();

            var principal = authState.User;

            if (principal.Identity?.IsAuthenticated != true)
            {
                errorMessage = "Необходимо войти в аккаунт.";
                return;
            }

            var userIdClaim =
                principal.FindFirst(ClaimTypes.NameIdentifier);
            
            if (userIdClaim is null || !int.TryParse(userIdClaim.Value, out currentUserId))
            {
                errorMessage = "Не удалось определить пользователя. Войдите повторно.";
                return;
            }

            await using var db = await DbFactory.CreateDbContextAsync();

            var user = await db.Users
                .AsNoTracking()
                .FirstOrDefaultAsync(u => u.Id == currentUserId);

            if (user is null)
            {
                errorMessage = "Пользователь не найден.";
                return;
            }

            Input.Email = user.Email;
            Input.Name = user.Name ?? string.Empty;
            Input.Surname = user.Surname ?? string.Empty;
            Input.Phone = user.Phone ?? string.Empty;
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Ошибка загрузки личного кабинета: {ex}");

            errorMessage = "Не удалось загрузить данные. Попробуйте позже.";
        }
        finally
        {
            isLoading = false;
        }
    }

    private async Task SaveChanges()
    {
        isSaving = true;
        errorMessage = null;
        successMessage = null;
        isSaved = false;

        try
        {
            var authState =
                    await AuthenticationStateProvider
                        .GetAuthenticationStateAsync();

            var principal = authState.User;

            if (principal.Identity?.IsAuthenticated != true)
            {
                errorMessage = "Необходимо войти в аккаунт.";
                return;
            }

            var userIdClaim =
                    principal.FindFirst(ClaimTypes.NameIdentifier);

            if (userIdClaim is null ||
                !int.TryParse(userIdClaim.Value, out var userId) ||
                userId != currentUserId)
            {
                errorMessage = "Не удалось подтвердить пользователя. Войдите повторно.";
                return;
            }

            await using var db = await DbFactory.CreateDbContextAsync();

            var user = await db.Users
                .FirstOrDefaultAsync(u => u.Id == userId);

            if (user is null)
            {
                errorMessage = "Пользователь не найден.";
                return;
            }

            user.Name = EmptyToNull(Input.Name);
            user.Surname = EmptyToNull(Input.Surname);
            user.Phone = EmptyToNull(Input.Phone);

            await db.SaveChangesAsync();

            Input.Name = user.Name ?? string.Empty;
            Input.Surname = user.Surname ?? string.Empty;
            Input.Phone = user.Phone ?? string.Empty;

            isSaved = true;
            successMessage = "Данные успешно сохранены.";
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Ошибка сохранения личного кабинета: {ex}");
            errorMessage = "Не удалось сохранить данные. Попробуйте позже.";
        }
        finally
        {
            isSaving = false;
        }
    }

    private static string GetValue(string? value)
    {
        return string.IsNullOrWhiteSpace(value) ? "Отсутствует" : value;
    }

    private static string? EmptyToNull(string? value)
    {
        return string.IsNullOrWhiteSpace(value) ? null : value.Trim();
    }

    private sealed class UserInput
    {
        public string Email { get; set; } = string.Empty;

        [RegularExpression(@"^[А-Яа-яЁёA-Za-z]+$|^$",
            ErrorMessage = "Имя должно содержать только русские или английские буквы.")]
        public string Name { get; set; } = string.Empty;

        [RegularExpression(@"^[А-Яа-яЁёA-Za-z-]+$|^$",
            ErrorMessage = "Фамилия может содержать только буквы и дефис.")]
        public string Surname { get; set; } = string.Empty;

        [RegularExpression(@"^[0-9]{10}$|^$",
            ErrorMessage = "Телефон должен содержать ровно 10 цифр.")]
        public string Phone { get; set; } = string.Empty;
    }
}
