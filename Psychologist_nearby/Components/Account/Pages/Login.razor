@page "/Account/Login"

@using System.ComponentModel.DataAnnotations
@using System.Security.Claims
@using Microsoft.AspNetCore.Authentication
@using Microsoft.AspNetCore.Authentication.Cookies
@using Microsoft.EntityFrameworkCore
@using Psychologist_nearby.Data

@inject ApplicationDbContext DbContext
@inject ILogger<Login> Logger
@inject NavigationManager NavigationManager
@inject Psychologist_nearby.Data.IAuthValidator AuthValidator
@inject EmailSender EmailSender

<PageTitle>Вход в кабинет</PageTitle>

<div class="login-page-container">
    <div class="login-card">
        <h1 class="login-title">Вход в кабинет</h1>

        @if (!string.IsNullOrEmpty(errorMessage))
        {
            <div class="alert alert-danger">@errorMessage</div>
        }

        <EditForm Model="Input" method="post" OnValidSubmit="LoginUser" FormName="login">
            <DataAnnotationsValidator />

            <div class="form-group">
                <label for="email" class="form-label">Email</label>
                <InputText @bind-Value="Input.Email" class="form-control" autocomplete="username" aria-required="true" placeholder="name@example.com" />
                <ValidationMessage For="() => Input.Email" />
            </div>

            <div class="form-group">
                <label for="password" class="form-label">Пароль</label>
                <InputText type="password" @bind-Value="Input.Password" class="form-control" autocomplete="current-password" placeholder="••••••••" />
                <ValidationMessage For="() => Input.Password" />
            </div>

            <div class="checkbox-group" style="margin-bottom: 15px;">
                <InputCheckbox @bind-Value="Input.RememberMe" id="rememberMe" class="checkbox-input" />
                <label for="rememberMe" class="checkbox-label" style="margin-left: 8px;">Запомнить меня</label>
            </div>

            <button type="submit" class="btn-submit">
                Продолжить
            </button>

            <div class="register-link-container">
                <a href="@(NavigationManager.GetUriWithQueryParameters("Account/Register", new Dictionary<string, object?> { ["ReturnUrl"] = ReturnUrl }))" class="register-link">
                    Зарегистрироваться
                </a>
            </div>
        </EditForm>
    </div>
</div>

@code {
    private string? errorMessage;
    string? verifyUrl = null;

    [CascadingParameter]
    private HttpContext HttpContext { get; set; } = default!;

    [SupplyParameterFromForm(FormName = "login")]
    private InputModel Input { get; set; } = new();

    [SupplyParameterFromQuery]
    private string? ReturnUrl { get; set; }

    public async Task LoginUser()
    {

        try
        {
            errorMessage = null;

            if (!AuthValidator.TryNormalizeEmail(Input.Email, out var email, out var emailError))
            {
                errorMessage = emailError;
                return;
            }

            var user = await DbContext.Users
                .Include(u => u.Role)
                .FirstOrDefaultAsync(u => u.Email == email);

            if (user == null || !BCrypt.Net.BCrypt.Verify(Input.Password, user.PasswordHash))
            {
                errorMessage = "Ошибка: Неверный email или пароль.";
                return;
            }

            // Генерация 6-значного кода
            string code = new Random().Next(100000, 999999).ToString();

            user.EmailConfirmationCode = code;
            user.CodeExpiryTime = DateTime.Now.AddMinutes(5);
            await DbContext.SaveChangesAsync();

            try
            {
                await EmailSender.SendEmailAsync(
                    user.Email,
                    "Код подтверждения входа",
                    $"Ваш код подтверждения: {code}\n" +
                    "Код действителен в течение 5 минут.");
            }
            catch
            {
                user.EmailConfirmationCode = null;
                user.CodeExpiryTime = null;
                await DbContext.SaveChangesAsync();

                errorMessage =
                    "Не удалось отправить код на почту. Попробуйте позже.";
                return;
            }

            var query = new Dictionary<string, object?>
            {
                ["email"] = user.Email,
                ["rememberMe"] = Input.RememberMe,
                ["returnUrl"] = ReturnUrl
            };

            verifyUrl = NavigationManager.GetUriWithQueryParameters("/Account/VerifyCode",query);

        }
        catch (Exception ex)
        {
            Logger.LogError(ex,"Ошибка при авторизации пользователя {Email}", Input.Email);

            errorMessage =
                "Произошла ошибка при попытке входа.";
        }

        if (verifyUrl != null)
        {
            NavigationManager.NavigateTo(verifyUrl, forceLoad: true);
        }
    }

    private sealed class InputModel
    {
        [Required(ErrorMessage = "Введите e-mail")]
        [EmailAddress(ErrorMessage = "Введите корректный адрес электронной почты")]
        public string Email { get; set; } = "";

        [Required(ErrorMessage = "Введите пароль")]
        [DataType(DataType.Password)]
        public string Password { get; set; } = "";

        [Display(Name = "Запомнить меня")]
        public bool RememberMe { get; set; }
    }
}