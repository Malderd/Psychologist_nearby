@inject NavigationManager NavigationManager

@code {
    protected override void OnInitialized()
    {
        var currentUri = NavigationManager.Uri;

        var loginUri = NavigationManager.ToAbsoluteUri("/Account/Login");

        if (NavigationManager.ToAbsoluteUri(currentUri).AbsolutePath
            .Equals(loginUri.AbsolutePath, StringComparison.OrdinalIgnoreCase))
        {
            return;
        }

        NavigationManager.NavigateTo(
            $"/Account/Login?returnUrl={Uri.EscapeDataString(currentUri)}",
            forceLoad: true);
    }
}