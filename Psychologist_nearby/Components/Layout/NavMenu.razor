<header class="top-nav">
    <div class="nav-container">
        <!-- Заголовок -->
        <a class="nav-brand" href="">Психолог рядом</a>

        <!-- Кнопка мобильного меню -->
        <button class="nav-toggle" type="button" @onclick="() => isMenuOpen = !isMenuOpen" aria-label="Открыть меню">
            <span class="toggle-icon"></span>
        </button>

        <!-- Основная навигация -->
        <div class="nav-menu @(isMenuOpen ? "open" : "")">
            <!-- Ссылки сайта -->
            <nav class="nav-links">
                <NavLink class="nav-item">Обо мне</NavLink>
                <NavLink class="nav-item">Запросы</NavLink>
                <NavLink class="nav-item">Отзывы</NavLink>
                <NavLink class="nav-item">Стоимость</NavLink>
                <NavLink class="nav-item">Тестирование</NavLink>
                <NavLink class="nav-item">Контакты</NavLink>
            </nav>

            <!-- Авторизация справа -->
            <div class="auth-links">
                <AuthorizeView>
                    <Authorized>
                        <NavLink class="nav-item user-name" href="Account/Manage">@context.User.Identity?.Name</NavLink>
                        <form action="Account/Logout" method="post" class="logout-form">
                            <AntiforgeryToken />
                            <button type="submit" class="btn-logout">Выйти</button>
                        </form>
                    </Authorized>
                    <NotAuthorized>
                        <NavLink class="nav-item" href="Account/Register">Регистрация</NavLink>
                        <NavLink class="btn-login" href="Account/Login">Войти</NavLink>
                    </NotAuthorized>
                </AuthorizeView>
            </div>
        </div>
    </div>
</header>

@code {
    private bool isMenuOpen = false;
}